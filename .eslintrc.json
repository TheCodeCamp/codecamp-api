{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "no-empty": "warn"
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "env": { "jest": true }
    }
  ],
  "ignorePatterns": ["node_modules/", "codecamp-front/", "judge/result/", "server/public/"]
}
