# Copy to .env and adjust. The server reads these via server/config.
NODE_ENV=development

# MongoDB connection (shared by the API server and the Go judge)
MONGODB_URI=mongodb://127.0.0.1:27017/OnlineJudge

# Auth — REQUIRED in production (the server refuses to boot without them)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_KEYS=change-key-one,change-key-two

# Ports / service wiring
PORT_SERVER=80
JUDGE_URL=http://localhost:3001

# Go judge (read by judge/cmd/judge)
JUDGE_PORT=3001
